loat diffuse = max(dot(normal, lightDir), 0.0);\n  \n  // 加上一点环境光\n  vec3 color = vec3(1.0, 0.5, 0.2) * (diffuse + 0.1);\n  \n  gl_FragColor = vec4(color, 1.0);\n}\n`\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"总结\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"恭喜你！你已经复习了 Shader 编程中最核心的数学概念：\"\n    }), \"\\n\", _jsxs(_components.ol, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"向量\"\n        }), \"：装数字的容器，表示颜色或位置。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"长度 (length)\"\n        }), \"：测量距离，画圆的基础。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"插值 (mix)\"\n        }), \"：颜色的混合器。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"平滑 (smoothstep)\"\n        }), \"：让一切变柔和的滤镜。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"正弦 (sin)\"\n        }), \"：制造动画和波动的引擎。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"点积 (dot)\"\n        }), \"：计算光照和方向一致性的工具。\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"这些公式不需要死记硬背。在写 Shader 的过程中，你会一遍又一遍地用到它们，直到它们像呼吸一样自然。\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = props.components || ({});\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\nfunction _missingMdxReference(id, component) {\n  throw new Error(\"Expected \" + (component ? \"component\" : \"object\") + \" `\" + id + \"` to be defined: you likely forgot to import, pass, or provide it.\");\n}\n","rawContent":"\n# 重拾数学：写给前端的 GLSL 数学补习班\n\n听到\"图形学数学\"，很多人的第一反应是恐惧：复杂的公式、看不懂的符号、痛苦的考试回忆。\n\n但好消息是：**写 Shader 不需要你成为数学家。** 你只需要掌握几个核心工具，就能解决 90% 的问题。而且在 Shader 中，数学不再是纸上的符号，而是**看得见的颜色和形状**。\n\n本文将用最直观的方式，帮你捡起那些\"最有用\"的数学知识。\n\n## 一、 向量 (Vector)：一切的基础\n\n在学校里，向量是\"有大小和方向的量\"。在 GLSL 中，它就是**一个装着数字的盒子**。\n\n*   `vec2(x, y)`: 2个数字。常用于坐标 (UV)、2D 位置。\n*   `vec3(r, g, b)`: 3个数字。常用于颜色、3D 位置。\n*   `vec4(r, g, b, a)`: 4个数字。常用于带透明度的颜色。\n\n### 1. 向量加减法\n想象你在地图上走路。\n*   **加法**：你从 A 点出发，走了一段距离（向量 V），就到了 B 点。`B = A + V`。\n*   **减法**：你想知道从 A 到 B 怎么走？`V = B - A`。\n\n### 2. 向量乘法（缩放）\n`vec2 v = vec2(1.0, 2.0);`\n`v * 2.0` 变成了 `vec2(2.0, 4.0)`。方向没变，但是步子迈得更大了。\n\n<ShaderPreview title=\"向量颜色\" code={`\nvarying vec2 vUv;\n\nvoid main() {\n    // vUv 就是一个向量 vec2(x, y)\n    // 我们可以直接把向量赋值给颜色\n    // x 变成红色，y 变成绿色\n    gl_FragColor = vec4(vUv.x, vUv.y, 0.0, 1.0);\n}\n`} />\n\n## 二、 距离 (Distance)与长度 (Length)\n\n如果你想画一个圆，或者想知道两个物体离得有多远，你需要求**模**（长度）。\n在 GLSL 中，只需要一个函数：`length()`。\n\n*   `length(vec2(3.0, 4.0))` 结果是 `5.0` (勾股定理：3² + 4² = 5²)。\n\n**实战：画光晕**\n计算当前像素距离中心的距离，距离越近越亮。\n\n<ShaderPreview title=\"Distance Field\" code={`\nvarying vec2 vUv;\n\nvoid main() {\n    // 1. 把原点移到中心\n    vec2 center = vUv - 0.5;\n    \n    // 2. 计算距离\n    float d = length(center);\n    \n    // 3. 距离越近(d越小)，颜色越亮\n    // 我们用 1.0 / d 来制造发光效果\n    float glow = 0.05 / d;\n    \n    gl_FragColor = vec4(vec3(glow), 1.0);\n}\n`} />\n\n## 三、 插值 (Mix/Lerp)\n\n这是 Shader 中最最最常用的函数：`mix(x, y, a)`。\n它的意思是：**根据比例 a，混合 x 和 y。**\n\n*   如果 `a = 0.0`，结果是 `x`。\n*   如果 `a = 1.0`，结果是 `y`。\n*   如果 `a = 0.5`，结果是 `x` 和 `y` 的平均值。\n\n想象你在调色板上调色，`x` 是红色，`y` 是蓝色。`a` 就是你加蓝色的比例。\n\n<ShaderPreview title=\"Color Mixing\" code={`\nvarying vec2 vUv;\n\nvoid main() {\n    vec3 red = vec3(1.0, 0.0, 0.0);\n    vec3 blue = vec3(0.0, 0.0, 1.0);\n    \n    // 随 X 轴从左到右，从红变蓝\n    vec3 color = mix(red, blue, vUv.x);\n    \n    gl_FragColor = vec4(color, 1.0);\n}\n`} />\n\n## 四、 平滑过渡 (Smoothstep)\n\n如果你只需要记住一个 GLSL 函数，那一定是 `smoothstep`。\n它是一个**魔法过滤器**。\n\n*   `step(edge, x)`: 硬切。小于 `edge` 是 0，大于 `edge` 是 1。边缘像刀切一样锋利（有锯齿）。\n*   `smoothstep(edge1, edge2, x)`: 软切。在 `edge1` 和 `edge2` 之间，它会生成一条平滑的 S 型曲线。\n\n**为什么它这么重要？**\n因为自然界没有绝对锋利的边缘。阴影是柔和的，水波是渐变的。用 `smoothstep` 可以让你的画面瞬间从\"像个程序\"变成\"像个艺术品\"。\n\n<ShaderPreview title=\"Step vs Smoothstep\" code={`\nvarying vec2 vUv;\n\nvoid main() {\n    float x = vUv.x;\n    \n    // 上半部分：硬切 (Step)\n    float hard = step(0.5, x);\n    \n    // 下半部分：软切 (Smoothstep)\n    // 在 0.4 到 0.6 之间平滑过渡\n    float soft = smoothstep(0.4, 0.6, x);\n    \n    // 拼合显示\n    float final = (vUv.y > 0.5) ? hard : soft;\n    \n    gl_FragColor = vec4(vec3(final), 1.0);\n}\n`} />\n\n## 五、 周期与波动 (Sin/Cos)\n\n这就是我们在学校学的**三角函数**。但在 Shader 里，你不需要算三角形边长，你只需要知道：**它们是制造波动的机器。**\n\n*   `sin(x)`: 输出在 -1 到 1 之间反复横跳。\n*   想让波动变快？`sin(x * 10.0)` (增加频率)\n*   想让波动幅度变大？`sin(x) * 5.0` (增加振幅)\n*   想让波动整体抬高？`sin(x) + 2.0` (垂直位移)\n\n**应用场景**：呼吸灯、水波纹、摆动的草、闪烁的星星。\n\n<ShaderPreview title=\"Sin Wave\" code={`\nuniform float uTime;\nvarying vec2 vUv;\n\nvoid main() {\n    // 1. 基础正弦波\n    float y = sin(vUv.x * 10.0 + uTime) * 0.2;\n    \n    // 2. 把它画出来\n    // 如果当前像素的 y 接近计算出的波浪 y (中心在 0.5)\n    float line = 1.0 - smoothstep(0.01, 0.02, abs(vUv.y - 0.5 - y));\n    \n    gl_FragColor = vec4(vec3(line), 1.0);\n}\n`} />\n\n## 六、 点积 (Dot Product)\n\n这个听起来有点硬核，但它的几何意义非常直观：**两个方向有多\"一致\"？**\n\n*   `dot(A, B)`\n*   如果 A 和 B 方向**相同**，结果是 1.0。\n*   如果 A 和 B **垂直**（完全无关），结果是 0.0。\n*   如果 A 和 B **相反**，结果是 -1.0。\n\n**最经典应用：光照**\n光照怎么算？看**光线方向**和**物体表面朝向（法线）**的夹角。\n*   正对着光：最亮 (`dot = 1`)。\n*   侧对着光：变暗。\n*   背对着光：全黑 (`dot <= 0`)。\n\n这就所谓的 **Lambert 光照模型**，3D 渲染的基石。\n\n<ShaderPreview title=\"Fake 3D Light\" code={`\nvarying vec2 vUv;\nuniform float uTime;\n\nvoid main() {\n    // 1. 模拟一个球体表面的法线 (Normal)\n    vec2 p = vUv * 2.0 - 1.0; // -1 到 1\n    float z = sqrt(1.0 - p.x*p.x - p.y*p.y); // 算出球面的 z\n    \n    // 如果在圆外，就涂黑\n    if (length(p) > 1.0) {\n        gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);\n        return;\n    }\n    \n    vec3 normal = vec3(p.x, p.y, z);\n    \n    // 2. 定义一个旋转的光源\n    vec3 lightDir = normalize(vec3(sin(uTime), 0.5, cos(uTime)));\n    \n    // 3. 核心：点积计算亮度\n    float diffuse = max(dot(normal, lightDir), 0.0);\n    \n    // 加上一点环境光\n    vec3 color = vec3(1.0, 0.5, 0.2) * (diffuse + 0.1);\n    \n    gl_FragColor = vec4(color, 1.0);\n}\n`} />\n\n## 总结\n\n恭喜你！你已经复习了 Shader 编程中最核心的数学概念：\n\n1.  **向量**：装数字的容器，表示颜色或位置。\n2.  **长度 (length)**：测量距离，画圆的基础。\n3.  **插值 (mix)**：颜色的混合器。\n4.  **平滑 (smoothstep)**：让一切变柔和的滤镜。\n5.  **正弦 (sin)**：制造动画和波动的引擎。\n6.  **点积 (dot)**：计算光照和方向一致性的工具。\n\n这些公式不需要死记硬背。在写 Shader 的过程中，你会一遍又一遍地用到它们，直到它们像呼吸一样自然。\n","isMdxCompiled":true,"category":"math","title":"重拾数学：写给前端的 GLSL 数学补习班","date":"2026-01-16","excerpt":"","tags":["WebGL","GLSL","Math","Tutorial"],"readingTime":"6 分钟阅读"}}
