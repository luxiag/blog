 }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"position\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{[10,\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"10\"\n            }), \", \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"10\"\n            }), \"]} \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"angle\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{0.15}\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"penumbra\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{1}\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"decay\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{0}\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"intensity\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{Math.PI}\"\n            }), \" />\"]\n          }), \"\\n      \", _jsxs(_components.span, {\n            className: \"hljs-tag\",\n            children: [\"<\", _jsx(_components.span, {\n              className: \"hljs-name\",\n              children: \"pointLight\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"position\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{[-10,\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"-10\"\n            }), \", \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"-10\"\n            }), \"]} \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"decay\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{0}\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"intensity\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{Math.PI}\"\n            }), \" />\"]\n          }), \"\\n      \", _jsxs(_components.span, {\n            className: \"hljs-tag\",\n            children: [\"<\", _jsx(_components.span, {\n              className: \"hljs-name\",\n              children: \"Box\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"position\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\n              children: \"{[-1.2,\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"0\"\n            }), \", \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"0\"\n            }), \"]} />\"]\n          }), \"\\n      \", _jsxs(_components.span, {\n            className: \"hljs-tag\",\n            children: [\"<\", _jsx(_components.span, {\n              className: \"hljs-name\",\n              children: \"Box\"\n            }), \" \", _jsx(_components.span, {\n              className: \"hljs-attr\",\n              children: \"position\"\n            }), \"=\", _jsx(_components.span, {\n              className: \"hljs-string\",\