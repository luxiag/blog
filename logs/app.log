 {sceneConfig.items.map(item => (\n      <ItemFactory key={item.id} {...item} />\n    ))}\n    \n    {/* 渲染配置中的光照 */}\n    <ambientLight intensity={sceneConfig.lighting.ambient} />\n    <directionalLight \n      position={sceneConfig.lighting.directional.position} \n      intensity={sceneConfig.lighting.directional.intensity} \n    />\n    \n    <OrbitControls />\n  </>\n)\n}\n\nrender(\n<Canvas camera={{ position: [0, 2, 6] }}>\n  <GeneratedScene />\n</Canvas>\n)\n`\n    }), \"\\n\", _jsx(_components.hr, {}), \"\\n\", _jsx(_components.h2, {\n      children: \"四、 可测试性与可观测性\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"Web 3D 应用往往是“黑盒”，出了 Bug 很难复现。我们需要给它装上仪表盘。\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"1. 性能监控 (Stats)\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"时刻关注 FPS (帧率)、Draw Calls (绘制调用次数)、Triangles (面数)。\\n使用 \", _jsx(_components.code, {\n        children: \"r3f-perf\"\n      }), \" 或 \", _jsx(_components.code, {\n        children: \"stats.js\"\n      }), \"。\"]\n    }), \"\\n\", _jsx(_components.pre, {\n      children: _jsxs(_components.code, {\n        className: \"hljs language-javascript\",\n        children: [_jsx(_components.span, {\n          className: \"hljs-keyword\",\n          children: \"import\"\n        }), \" { \", _jsx(_components.span, {\n          className: \"hljs-title class_\",\n          children: \"Stats\"\n        }), \" } \", _jsx(_components.span, {\n          className: \"hljs-keyword\",\n          children: \"from\"\n        }), \" \", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"'@react-three/drei'\"\n        }), \"\\n\\n<\", _jsx(_components.span, {\n          className: \"hljs-title class_\",\n          children: \"Canvas\"\n        }), \">\\n  \", _jsx(_components.span, {\n          className: \"xml\",\n          children: _jsxs(_components.span, {\n            className: \"hljs-tag\",\n            children: [\"<\", _jsx(_components.sp