{"timestamp":"2026-01-14T02:35:18.332Z","level":"DEBUG","message":"Post data:","data":{"slug":"mdx-demo","content":"\"use strict\";\nconst {Fragment: _Fragment, jsx: _jsx, jsxs: _jsxs} = arguments[0];\nfunction _createMdxContent(props) {\n  const _components = {\n    blockquote: \"blockquote\",\n    code: \"code\",\n    h1: \"h1\",\n    h2: \"h2\",\n    li: \"li\",\n    p: \"p\",\n    pre: \"pre\",\n    span: \"span\",\n    table: \"table\",\n    tbody: \"tbody\",\n    td: \"td\",\n    th: \"th\",\n    thead: \"thead\",\n    tr: \"tr\",\n    ul: \"ul\",\n    ...props.components\n  }, {CodeRunner} = _components;\n  if (!CodeRunner) _missingMdxReference(\"CodeRunner\", true);\n  return _jsxs(_Fragment, {\n    children: [_jsx(_components.h1, {\n      children: \"MDX 组件演示\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"这是一个 MDX 文件，可以在 Markdown 中直接使用 React 组件。\"\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"基础 Markdown\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"普通的 Markdown 语法仍然可用：\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"列表项 1\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"列表项 2\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"列表项 3\"\n      }), \"\\n\"]\n    }), \"\\n\", _jsxs(_components.blockquote, {\n      children: [\"\\n\", _jsx(_components.p, {\n        children: \"这是一个引用块\"\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"代码示例\"\n    }), \"\\n\", _jsx(_components.pre, {\n      children: _jsxs(_components.code, {\n        className: \"hljs language-javascript\",\n        children: [_jsx(_components.span, {\n          className: \"hljs-keyword\",\n          children: \"function\"\n        }), \" \", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"greet\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-params\",\n          children: \"name\"\n        }), \") {\\n  \", _jsx(_components.span, {\n          className: \"hljs-keyword\",\n          children: \"return\"\n        }), \" \", _jsxs(_components.span, {\n          className: \"hljs-string\",\n          children: [\"`Hello, \", _jsx(_components.span, {\n            className: \"hljs-subst\",\n            children: \"${name}\"\n          }), \"!`\"]\n        }), \";\\n}\\n\\n\", _jsx(_components.span, {\n          className: \"hljs-variable language_\",\n          children: \"console\"\n        }), \".\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"log\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"greet\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"'World'\"\n        }), \"));\\n\"]\n      })\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"使用 JSX 组件\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"下面是一个交互式按钮组件：\"\n    }), \"\\n\", _jsx(\"button\", {\n      onClick: () => alert('Hello from MDX!'),\n      children: _jsx(_components.p, {\n        children: \"点击我\"\n      })\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"自定义组件\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"你可以在 \", _jsx(_components.code, {\n        children: \"mdx-components.tsx\"\n      }), \" 中定义自定义组件，然后直接在 MDX 文件中使用。\"]\n    }), \"\\n\", _jsx(CodeRunner, {\n      code: \"console.log('Hello from CodeRunner!');\",\n      language: \"javascript\"\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"表格\"\n    }), \"\\n\", _jsxs(_components.table, {\n      children: [_jsx(_components.thead, {\n        children: _jsxs(_components.tr, {\n          children: [_jsx(_components.th, {\n            children: \"功能\"\n          }), _jsx(_components.th, {\n            children: \"支持\"\n          })]\n        })\n      }), _jsxs(_components.tbody, {\n        children: [_jsxs(_components.tr, {\n          children: [_jsx(_components.td, {\n            children: \"Markdown\"\n          }), _jsx(_components.td, {\n            children: \"✅\"\n          })]\n        }), _jsxs(_components.tr, {\n          children: [_jsx(_components.td, {\n            children: \"JSX\"\n          }), _jsx(_components.td, {\n            children: \"✅\"\n          })]\n        }), _jsxs(_components.tr, {\n          children: [_jsx(_components.td, {\n            children: \"自定义组件\"\n          }), _jsx(_components.td, {\n            children: \"✅\"\n          })]\n        }), _jsxs(_components.tr, {\n          children: [_jsx(_components.td, {\n            children: \"代码高亮\"\n          }), _jsx(_components.td, {\n            children: \"✅\"\n          })]\n        })]\n      })]\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = props.components || ({});\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\nfunction _missingMdxReference(id, component) {\n  throw new Error(\"Expected \" + (component ? \"component\" : \"object\") + \" `\" + id + \"` to be defined: you likely forgot to import, pass, or provide it.\");\n}\n","rawContent":"\n# MDX 组件演示\n\n这是一个 MDX 文件，可以在 Markdown 中直接使用 React 组件。\n\n## 基础 Markdown\n\n普通的 Markdown 语法仍然可用：\n\n- 列表项 1\n- 列表项 2\n- 列表项 3\n\n> 这是一个引用块\n\n## 代码示例\n\n```javascript\nfunction greet(name) {\n  return `Hello, ${name}!`;\n}\n\nconsole.log(greet('World'));\n```\n\n## 使用 JSX 组件\n\n下面是一个交互式按钮组件：\n\n<button onClick={() => alert('Hello from MDX!')}>\n  点击我\n</button>\n\n## 自定义组件\n\n你可以在 `mdx-components.tsx` 中定义自定义组件，然后直接在 MDX 文件中使用。\n\n<CodeRunner code=\"console.log('Hello from CodeRunner!');\" language=\"javascript\" />\n\n## 表格\n\n| 功能 | 支持 |\n|------|------|\n| Markdown | ✅ |\n| JSX | ✅ |\n| 自定义组件 | ✅ |\n| 代码高亮 | ✅ |\n","isMdxCompiled":true,"title":"MDX 组件演示","date":"2026-01-14","excerpt":"演示在 MDX 文件中使用 React 组件","tags":["MDX","React","教程"],"readingTime":"1 分钟阅读"}}
