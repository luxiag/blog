{"timestamp":"2026-01-23T03:29:33.346Z","level":"DEBUG","message":"Post data:","data":{"slug":"sql-exercises","content":"\"use strict\";\nconst {Fragment: _Fragment, jsx: _jsx, jsxs: _jsxs} = arguments[0];\nconst initSql = `\nCREATE TABLE users (id INT, name TEXT, city TEXT, age INT);\nINSERT INTO users VALUES (1, 'Alice', 'Beijing', 25), (2, 'Bob', 'Shanghai', 30), (3, 'Charlie', 'Beijing', 22), (4, 'David', 'Shenzhen', 28);\n\nCREATE TABLE orders (id INT, user_id INT, amount INT, status TEXT);\nINSERT INTO orders VALUES (101, 1, 100, 'PAID'), (102, 1, 200, 'PAID'), (103, 2, 50, 'PENDING'), (104, 3, 300, 'SHIPPED'), (105, 99, 500, 'PAID');\n`;\nfunction _createMdxContent(props) {\n  const _components = {\n    blockquote: \"blockquote\",\n    code: \"code\",\n    h1: \"h1\",\n    h2: \"h2\",\n    h3: \"h3\",\n    hr: \"hr\",\n    li: \"li\",\n    ol: \"ol\",\n    p: \"p\",\n    strong: \"strong\",\n    table: \"table\",\n    tbody: \"tbody\",\n    td: \"td\",\n    th: \"th\",\n    thead: \"thead\",\n    tr: \"tr\",\n    ...props.components\n  }, {SqlSimulator} = _components;\n  if (!SqlSimulator) _missingMdxReference(\"SqlSimulator\", true);\n  return _jsxs(_Fragment, {\n    children: [_jsx(_components.h1, {\n      children: \"SQL 实战练习：在线运行 + 实时验证\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"纸上得来终觉浅，绝知此事要躬行。\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"本文内置了一个 \", _jsx(_components.strong, {\n        children: \"轻量级 SQL 模拟器\"\n      }), \"（基于 \", _jsx(_components.code, {\n        children: \"sql.js\"\n      }), \"/SQLite），你可以在每一道题的编辑器中直接编写并运行 SQL，结果会实时显示。\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"我们预置了两张表用于练习：\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: _jsxs(_components.strong, {\n        children: [\"1. 用户表 (\", _jsx(_components.code, {\n          children: \"users\"\n        }), \")\"]\n      })\n    }), \"\\n\", _jsxs(_components.table, {\n      children: [_jsx(_components.thead, {\n        chil