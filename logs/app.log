\n\", _jsx(_components.p, {\n      children: \"如果你能把这 21 道题都独立写出来，你的 SQL 已经能覆盖大多数日常数据分析与报表需求。\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"下一步建议：\"\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [\"学会读执行计划（在真实数据库里看 \", _jsx(_components.code, {\n          children: \"EXPLAIN\"\n        }), \"）\"]\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"练习索引设计与慢查询优化（这部分需要 MySQL/PostgreSQL 环境）\"\n      }), \"\\n\"]\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = props.components || ({});\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\nfunction _missingMdxReference(id, component) {\n  throw new Error(\"Expected \" + (component ? \"component\" : \"object\") + \" `\" + id + \"` to be defined: you likely forgot to import, pass, or provide it.\");\n}\n","rawContent":"\n# SQL 练习实验室：从入门到进阶（内置可运行模拟器）\n\n这篇文章的目标很明确：用一套“小而全”的电商数据，把你在工作中最常写的 SQL 场景从易到难练一遍。\n\n你不需要安装任何数据库：下面这个 SQL 模拟器会在浏览器里创建 SQLite 数据库并执行你的 SQL。\n\n<SqlSimulator\n  dataset=\"commerce\"\n  title=\"SQL 模拟器（本文数据集：电商订单）\"\n  description=\"建议：只写 SELECT/CTE 查询来练习。写坏了也没关系，点‘重置数据’即可恢复。\"\n/>\n\n---\n\n## 0. 数据集速览\n\n你会用到 5 张表：\n\n- `users(id, name, city, signup_date)`：用户\n- `products(id, name, category, price)`：商品\n- `orders(id, user_id, order_date, status)`：订单（含取消、退款、待支付）\n- `order_items(order_id, product_id, quantity, unit_price)`：订单明细（成交价以 unit_price 为准）\n- `payments(id, order_id, paid_at, amount, method, status)`：支付（SUCCESS / PENDING / FAILED / REFUNDED）\n\n---\n\n## 1. 入门（查询基础）\n\n### 练习 1：查询所有用户\n\n目标：查出 `users` 表全部字段，按 `id` 升序。\n\n::: details 参考答案\n```sql\nSELECT *\nFROM users\nORDER BY id;\n```\n:::\n\n### 练习 2：条件过滤（WHERE）\n\n目标：找出 `city = 'Beijing'` 的用户，返回 `id, name, signup_date`。\n\n::: details 参考答案\n```sql\nSELECT id, name, signup_date\nFROM users\nWHERE city = 'Beijing'\nORDER BY id;\n```\n:::\n\n### 练习 3：范围过滤（BETWEEN）\n\n目标：找出注册日期在 `2025-12-01` 到 `2026-01-31` 的用户。\n\n::: details 参考答案\n```sql\nSELECT *\nFROM users\nWHERE signup_date BETWEEN '2025-12-01' AND '2026-01-31'\nORDER BY signup_date;\n```\n:::\n\n### 练习 4：排序与分页（ORDER BY + LIMIT）\n\n目标：查询最贵的 3 个商品，返回 `name, category, price`。\n\n::: details 参考答案\n```sql\nSELECT name, category, price\nFROM products\nORDER BY price DESC\nLIMIT 3;\n```\n:::\n\n---\n\n## 2. 基础统计（聚合与分组）\n\n### 练习 5：分组统计（GROUP BY）\n\n目标：统计每个城市有多少用户，返回 `city, user_cnt`，按 `user_cnt` 降序。\n\n::: details 参考答案\n```sql\nSELECT city, COUNT(*) AS user_cnt\nFROM users\nGROUP BY city\nORDER BY user_cnt DESC, city;\n```\n:::\n\n### 练习 6：分组后过滤（HAVING）\n\n目标：找出用户数不少于 2 的城市。\n\n::: details 参考答案\n```sql\nSELECT city, COUNT(*) AS user_cnt\nFROM users\nGROUP BY city\nHAVING COUNT(*) >= 2\nORDER BY user_cnt DESC, city;\n```\n:::\n\n### 练习 7：订单状态分布\n\n目标：统计 `orders` 每种 `status` 的订单数。\n\n::: details 参考答案\n```sql\nSELECT status, COUNT(*) AS order_cnt\nFROM orders\nGROUP BY status\nORDER BY order_cnt DESC, status;\n```\n:::\n\n### 练习 8：只统计成功支付的收入\n\n目标：计算 `payments` 中 `status = 'SUCCESS'` 的总收入（sum(amount)）。\n\n::: details 参考答案\n```sql\nSELECT SUM(amount) AS revenue\nFROM payments\nWHERE status = 'SUCCESS';\n```\n:::\n\n---\n\n## 3. 多表查询（JOIN）\n\n### 练习 9：订单列表（JOIN users）\n\n目标：列出每笔订单的 `order_id, user_name, city, order_date, status`。\n\n::: details 参考答案\n```sql\nSELECT\n  o.id AS order_id,\n  u.name AS user_name,\n  u.city,\n  o.order_date,\n  o.status\nFROM orders o\nJOIN users u ON u.id = o.user_id\nORDER BY o.order_date, o.id;\n```\n:::\n\n### 练习 10：订单明细（JOIN 多表）\n\n目标：列出订单明细行：`order_id, user_name, product_name, quantity, unit_price`。\n\n::: details 参考答案\n```sql\nSELECT\n  oi.order_id,\n  u.name AS user_name,\n  p.name AS product_name,\n  oi.quantity,\n  oi.unit_price\nFROM order_items oi\nJOIN orders o ON o.id = oi.order_id\nJOIN users u ON u.id = o.user_id\nJOIN products p ON p.id = oi.product_id\nORDER BY oi.order_id, p.id;\n```\n:::\n\n### 练习 11：计算每笔订单的订单金额\n\n目标：每笔订单的金额 = `SUM(quantity * unit_price)`，输出 `order_id, order_amount`。\n\n::: details 参考答案\n```sql\nSELECT\n  order_id,\n  SUM(quantity * unit_price) AS order_amount\nFROM order_items\nGROUP BY order_id\nORDER BY order_id;\n```\n:::\n\n### 练习 12：订单金额 + 用户信息\n\n目标：输出 `order_id, user_name, order_date, order_amount`。\n\n::: details 参考答案\n```sql\nSELECT\n  o.id AS order_id,\n  u.name AS user_name,\n  o.order_date,\n  SUM(oi.quantity * oi.unit_price) AS order_amount\nFROM orders o\nJOIN users u ON u.id = o.user_id\nJOIN order_items oi ON oi.order_id = o.id\nGROUP BY o.id, u.name, o.order_date\nORDER BY o.order_date, o.id;\n```\n:::\n\n---\n\n## 4. 典型业务题（子查询 / EXISTS / 反连接）\n\n### 练习 13：找出从未下过单的用户\n\n目标：输出 `user_id, name`。\n\n::: details 参考答案（NOT EXISTS）\n```sql\nSELECT u.id, u.name\nFROM users u\nWHERE NOT EXISTS (\n  SELECT 1\n  FROM orders o\n  WHERE o.user_id = u.id\n)\nORDER BY u.id;\n```\n:::\n\n### 练习 14：找出从未被购买过的商品\n\n目标：输出 `product_id, name`。\n\n::: details 参考答案\n```sql\nSELECT p.id AS product_id, p.name\nFROM products p\nWHERE NOT EXISTS (\n  SELECT 1\n  FROM order_items oi\n  WHERE oi.product_id = p.id\n)\nORDER BY p.id;\n```\n:::\n\n### 练习 15：下过“Furniture”类商品的用户\n\n目标：输出去重后的 `user_id, name`。\n\n::: details 参考答案\n```sql\nSELECT DISTINCT u.id, u.name\nFROM users u\nJOIN orders o ON o.user_id = u.id\nJOIN order_items oi ON oi.order_id = o.id\nJOIN products p ON p.id = oi.product_id\nWHERE p.category = 'Furniture'\nORDER BY u.id;\n```\n:::\n\n---\n\n## 5. 可复用查询（CTE）\n\n### 练习 16：用 CTE 复用“订单金额”\n\n目标：用 `WITH order_amounts AS (...)` 先算订单金额，再关联 `orders` 输出 `order_id, user_id, order_date, status, order_amount`。\n\n::: details 参考答案\n```sql\nWITH order_amounts AS (\n  SELECT\n    order_id,\n    SUM(quantity * unit_price) AS order_amount\n  FROM order_items\n  GROUP BY order_id\n)\nSELECT\n  o.id AS order_id,\n  o.user_id,\n  o.order_date,\n  o.status,\n  oa.order_amount\nFROM orders o\nJOIN order_amounts oa ON oa.order_id = o.id\nORDER BY o.order_date, o.id;\n```\n:::\n\n### 练习 17：对账：支付金额是否等于订单金额\n\n目标：输出 `order_id, order_amount, paid_amount, diff`，只看支付 `status='SUCCESS'`。\n\n::: details 参考答案\n```sql\nWITH order_amounts AS (\n  SELECT order_id, SUM(quantity * unit_price) AS order_amount\n  FROM order_items\n  GROUP BY order_id\n), paid AS (\n  SELECT order_id, SUM(amount) AS paid_amount\n  FROM payments\n  WHERE status = 'SUCCESS'\n  GROUP BY order_id\n)\nSELECT\n  oa.order_id,\n  oa.order_amount,\n  p.paid_amount,\n  (p.paid_amount - oa.order_amount) AS diff\nFROM order_amounts oa\nJOIN paid p ON p.order_id = oa.order_id\nORDER BY ABS(diff) DESC, oa.order_id;\n```\n:::\n\n---\n\n## 6. 进阶分析（窗口函数）\n\n### 练习 18：每个用户的下单次数排名\n\n目标：输出 `user_id, user_name, order_cnt, rank`（按下单次数从多到少排名）。\n\n::: details 参考答案\n```sql\nWITH user_orders AS (\n  SELECT user_id, COUNT(*) AS order_cnt\n  FROM orders\n  GROUP BY user_id\n)\nSELECT\n  u.id AS user_id,\n  u.name AS user_name,\n  COALESCE(uo.order_cnt, 0) AS order_cnt,\n  RANK() OVER (ORDER BY COALESCE(uo.order_cnt, 0) DESC) AS rank\nFROM users u\nLEFT JOIN user_orders uo ON uo.user_id = u.id\nORDER BY rank, user_id;\n```\n:::\n\n### 练习 19：每个用户最近一笔订单\n\n目标：输出每个用户的 `user_id, name, last_order_id, last_order_date`，没有订单的用户也要保留。\n\n::: details 参考答案\n```sql\nWITH ranked_orders AS (\n  SELECT\n    o.*,\n    ROW_NUMBER() OVER (PARTITION BY o.user_id ORDER BY o.order_date DESC, o.id DESC) AS rn\n  FROM orders o\n)\nSELECT\n  u.id AS user_id,\n  u.name,\n  ro.id AS last_order_id,\n  ro.order_date AS last_order_date\nFROM users u\nLEFT JOIN ranked_orders ro\n  ON ro.user_id = u.id AND ro.rn = 1\nORDER BY u.id;\n```\n:::\n\n### 练习 20：按日期的累计收入（Running Total）\n\n目标：只统计 `payments.status='SUCCESS'`，按天汇总收入，再做累计和，输出 `day, revenue, revenue_cum`。\n\n::: details 参考答案\n```sql\nWITH daily AS (\n  SELECT\n    date(paid_at) AS day,\n    SUM(amount) AS revenue\n  FROM payments\n  WHERE status = 'SUCCESS'\n  GROUP BY date(paid_at)\n)\nSELECT\n  day,\n  revenue,\n  SUM(revenue) OVER (ORDER BY day) AS revenue_cum\nFROM daily\nORDER BY day;\n```\n:::\n\n---\n\n## 7. 报表实战（综合题）\n\n### 练习 21：城市维度的核心指标报表\n\n目标：输出每个城市的报表，字段如下：\n\n- `city`\n- `user_cnt`（城市用户数）\n- `paid_order_cnt`（订单状态为 PAID 的订单数）\n- `success_payment_amount`（成功支付总额）\n\n要求：按 `success_payment_amount` 降序。\n\n::: details 参考答案\n```sql\nWITH city_users AS (\n  SELECT city, COUNT(*) AS user_cnt\n  FROM users\n  GROUP BY city\n), city_paid_orders AS (\n  SELECT u.city, COUNT(*) AS paid_order_cnt\n  FROM orders o\n  JOIN users u ON u.id = o.user_id\n  WHERE o.status = 'PAID'\n  GROUP BY u.city\n), city_payments AS (\n  SELECT u.city, SUM(p.amount) AS success_payment_amount\n  FROM payments p\n  JOIN orders o ON o.id = p.order_id\n  JOIN users u ON u.id = o.user_id\n  WHERE p.status = 'SUCCESS'\n  GROUP BY u.city\n)\nSELECT\n  cu.city,\n  cu.user_cnt,\n  COALESCE(cpo.paid_order_cnt, 0) AS paid_order_cnt,\n  COALESCE(cp.success_payment_amount, 0) AS success_payment_amount\nFROM city_users cu\nLEFT JOIN city_paid_orders cpo ON cpo.city = cu.city\nLEFT JOIN city_payments cp ON cp.city = cu.city\nORDER BY success_payment_amount DESC, cu.city;\n```\n:::\n\n---\n\n## 结尾建议\n\n如果你能把这 21 道题都独立写出来，你的 SQL 已经能覆盖大多数日常数据分析与报表需求。\n\n下一步建议：\n\n- 学会读执行计划（在真实数据库里看 `EXPLAIN`）\n- 练习索引设计与慢查询优化（这部分需要 MySQL/PostgreSQL 环境）\n\n","isMdxCompiled":true,"category":"sql","title":"SQL 练习实验室：从入门到进阶（内置可运行模拟器）","date":"2026-01-23","excerpt":"","tags":["SQL","Exercises","Interactive","SQLite"],"readingTime":"6 分钟阅读"}}
