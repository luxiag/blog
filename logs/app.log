), _jsx(_components.td, {\n            children: \"500\"\n          }), _jsx(_components.td, {\n            children: \"PAID\"\n          })]\n        })]\n      })]\n    }), \"\\n\", _jsxs(_components.blockquote, {\n      children: [\"\\n\", _jsxs(_components.p, {\n        children: [\"注意：订单表里有一条 \", _jsx(_components.code, {\n          children: \"user_id = 99\"\n        }), \" 的数据，它在用户表里找不到对应的用户（脏数据/测试数据）。\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.hr, {}), \"\\n\", \"\\n\", _jsx(_components.h2, {\n      children: \"第一部分：基础查询 (Simple)\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 1：查出所有来自北京的用户\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"请查询 \", _jsx(_components.code, {\n        children: \"users\"\n      }), \" 表，找出所有 \", _jsx(_components.code, {\n        children: \"city\"\n      }), \" 为 \", _jsx(_components.code, {\n        children: \"'Beijing'\"\n      }), \" 的用户，返回所有字段。\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT * FROM users WHERE ...\",\n      answerSql: \"SELECT * FROM users WHERE city = 'Beijing'\",\n      title: \"练习 1：条件过滤\",\n      description: \"提示：使用 WHERE 子句。注意字符串需要用单引号包裹。\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 2：排序与分页\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询 \", _jsx(_components.code, {\n        children: \"users\"\n      }), \" 表，按 \", _jsx(_components.code, {\n        children: \"age\"\n      }), \" 从大到小排序，并只取前 2 名。\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT * FROM users ...\",\n      answerSql: \"SELECT * FROM users ORDER BY age DESC LIMIT 2\",\n      title: \"练习 2：排序与限制\",\n      description: \"提示：使用 ORDER BY ... DESC 和 LIMIT。\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 3：简单的聚合\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询 \", _jsx(_components.code, {\n        children: \"orders\"\n      }), \" 表，计算所有订单的总金额（\", _jsx(_components.code, {\n        children: \"amount\"\n      }), \" 之和）。\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT ... FROM orders\",\n      answerSql: \"SELECT SUM(amount) AS total_amount FROM orders\",\n      title: \"练习 3：聚合函数\",\n      description: \"提示：使用 SUM() 函数。\"\n    }), \"\\n\", _jsx(_components.hr, {}), \"\\n\", _jsx(_components.h2, {\n      children: \"第二部分：分组与多表连接 (Medium)\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 4：分组统计\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询 \", _jsx(_components.code, {\n        children: \"orders\"\n      }), \" 表，统计每种 \", _jsx(_components.code, {\n        children: \"status\"\n      }), \"（状态）下的订单数量。\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT status, ... FROM orders GROUP BY ...\",\n      answerSql: \"SELECT status, COUNT(*) as cnt FROM orders GROUP BY status\",\n      title: \"练习 4：GROUP BY 分组\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 5：INNER JOIN\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询所有 \", _jsx(_components.strong, {\n        children: \"已下过订单\"\n      }), \" 的用户，返回 \", _jsx(_components.code, {\n        children: \"用户姓名(name)\"\n      }), \" 和 \", _jsx(_components.code, {\n        children: \"订单金额(amount)\"\n      }), \"。\\n(注意：\", _jsx(_components.code, {\n        children: \"user_id=99\"\n      }), \" 的订单不应该出现，因为它没有对应的用户)\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT u.name, o.amount FROM users u JOIN ...\",\n      answerSql: \"SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id\",\n      title: \"练习 5：内连接\",\n      description: \"INNER JOIN 只返回两张表都有匹配的数据。\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 6：LEFT JOIN\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询 \", _jsx(_components.strong, {\n        children: \"所有用户\"\n      }), \" 的姓名，以及他们的订单金额（如果有的话）。如果用户没有订单，订单金额显示为 \", _jsx(_components.code, {\n        children: \"NULL\"\n      }), \"。\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT u.name, o.amount FROM users u ...\",\n      answerSql: \"SELECT u.name, o.amount FROM users u LEFT JOIN orders o ON u.id = o.user_id\",\n      title: \"练习 6：左连接\",\n      description: \"LEFT JOIN 会保留左表（users）的所有行，即使右表（orders）没有匹配。\"\n    }), \"\\n\", _jsx(_components.hr, {}), \"\\n\", _jsx(_components.h2, {\n      children: \"第三部分：进阶挑战 (Hard)\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 7：分组后的过滤 (HAVING)\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询 \", _jsx(_components.code, {\n        children: \"users\"\n      }), \" 表，找出那些 \", _jsx(_components.strong, {\n        children: \"同名城市\"\n      }), \" 用户数量大于等于 2 的城市名称。（即：哪个城市住了 2 个或以上的人？）\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT city, COUNT(*) FROM users GROUP BY city ...\",\n      answerSql: \"SELECT city, COUNT(*) as cnt FROM users GROUP BY city HAVING cnt >= 2\",\n      title: \"练习 7：HAVING 子句\",\n      description: \"WHERE 过滤行，HAVING 过滤分组后的结果。\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 8：子查询\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询所有 \", _jsx(_components.strong, {\n        children: \"下过金额大于 200 的订单\"\n      }), \" 的用户姓名。\\n(可以使用 \", _jsx(_components.code, {\n        children: \"JOIN\"\n      }), \" 也可以使用 \", _jsx(_components.code, {\n        children: \"IN\"\n      }), \" 子查询，这里尝试用子查询)\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT name FROM users WHERE id IN (...)\",\n      answerSql: \"SELECT name FROM users WHERE id IN (SELECT user_id FROM orders WHERE amount > 200)\",\n      title: \"练习 8：IN 子查询\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 9：每个用户的总消费\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"查询每个用户的 \", _jsx(_components.code, {\n        children: \"name\"\n      }), \" 和 \", _jsx(_components.code, {\n        children: \"total_spent\"\n      }), \"（总消费金额）。如果用户没消费，显示 0 或 NULL 均可（高阶要求：显示 0）。\"]\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT u.name, SUM(o.amount) FROM ...\",\n      answerSql: \"SELECT u.name, COALESCE(SUM(o.amount), 0) as total_spent FROM users u LEFT JOIN orders o ON u.id = o.user_id GROUP BY u.name\",\n      title: \"练习 9：综合统计\",\n      description: \"提示：结合 LEFT JOIN 和 GROUP BY。处理 NULL 可以用 COALESCE() 或 IFNULL()。\"\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"练习 10：找出没有下过单的用户\"\n    }), \"\\n\", _jsx(SqlSimulator, {\n      initialSql: initSql,\n      defaultQuery: \"SELECT name FROM users WHERE ...\",\n      answerSql: \"SELECT name FROM users u WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.user_id = u.id)\",\n      title: \"练习 10：NOT EXISTS 或 LEFT JOIN ... IS NULL\",\n      description: \"这是经典的 'Find Missing' 问题。\"\n    }), \"\\n\", _jsx(_components.hr, {}), \"\\n\", _jsx(_components.h2, {\n      children: \"总结\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"通过这 10 道题，你已经覆盖了 SQL 中 90% 的日常使用场景：\"\n    }), \"\\n\", _jsxs(_components.ol, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"基础\"\n        }), \"：\", _jsx(_components.code, {\n          children: \"SELECT\"\n        }), \", \", _jsx(_components.code, {\n          children: \"WHERE\"\n        }), \", \", _jsx(_components.code, {\n          children: \"ORDER BY\"\n        }), \", \", _jsx(_components.code, {\n          children: \"LIMIT\"\n        })]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"聚合\"\n        }), \"：\", _jsx(_components.code, {\n          children: \"COUNT\"\n        }), \", \", _jsx(_components.code, {\n          children: \"SUM\"\n        }), \", \", _jsx(_components.code, {\n          children: \"GROUP BY\"\n        }), \", \", _jsx(_components.code, {\n          children: \"HAVING\"\n        })]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"连接\"\n        }), \"：\", _jsx(_components.code, {\n          children: \"INNER JOIN\"\n        }), \", \", _jsx(_components.code, {\n          children: \"LEFT JOIN\"\n        })]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"子查询\"\n        }), \"：\", _jsx(_components.code, {\n          children: \"IN\"\n        }), \", \", _jsx(_components.code, {\n          children: \"EXISTS\"\n        })]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"如果你能独立做完这些题，说明你已经具备了扎实的 SQL 基础。建议在真实数据库（MySQL/PostgreSQL）中继续深入学习索引优化与事务处理。\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = props.components || ({});\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  initSql,\n  default: MDXContent\n};\nfunction _missingMdxReference(id, component) {\n  throw new Error(\"Expected \" + (component ? \"component\" : \"object\") + \" `\" + id + \"` to be defined: you likely forgot to import, pass, or provide it.\");\n}\n","rawContent":"\n# SQL 实战练习：在线运行 + 实时验证\n\n纸上得来终觉浅，绝知此事要躬行。\n\n本文内置了一个 **轻量级 SQL 模拟器**（基于 `sql.js`/SQLite），你可以在每一道题的编辑器中直接编写并运行 SQL，结果会实时显示。\n\n我们预置了两张表用于练习：\n\n**1. 用户表 (`users`)**\n\n| id | name | city | age |\n|----|------|------|-----|\n| 1 | Alice | Beijing | 25 |\n| 2 | Bob | Shanghai | 30 |\n| 3 | Charlie | Beijing | 22 |\n| 4 | David | Shenzhen | 28 |\n\n**2. 订单表 (`orders`)**\n\n| id | user_id | amount | status |\n|----|---------|--------|--------|\n| 101 | 1 | 100 | PAID |\n| 102 | 1 | 200 | PAID |\n| 103 | 2 | 50 | PENDING |\n| 104 | 3 | 300 | SHIPPED |\n| 105 | 99 | 500 | PAID |\n\n> 注意：订单表里有一条 `user_id = 99` 的数据，它在用户表里找不到对应的用户（脏数据/测试数据）。\n\n---\n\nexport const initSql = `\nCREATE TABLE users (id INT, name TEXT, city TEXT, age INT);\nINSERT INTO users VALUES (1, 'Alice', 'Beijing', 25), (2, 'Bob', 'Shanghai', 30), (3, 'Charlie', 'Beijing', 22), (4, 'David', 'Shenzhen', 28);\n\nCREATE TABLE orders (id INT, user_id INT, amount INT, status TEXT);\nINSERT INTO orders VALUES (101, 1, 100, 'PAID'), (102, 1, 200, 'PAID'), (103, 2, 50, 'PENDING'), (104, 3, 300, 'SHIPPED'), (105, 99, 500, 'PAID');\n`;\n\n## 第一部分：基础查询 (Simple)\n\n### 练习 1：查出所有来自北京的用户\n\n请查询 `users` 表，找出所有 `city` 为 `'Beijing'` 的用户，返回所有字段。\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT * FROM users WHERE ...\"\n  answerSql=\"SELECT * FROM users WHERE city = 'Beijing'\"\n  title=\"练习 1：条件过滤\"\n  description=\"提示：使用 WHERE 子句。注意字符串需要用单引号包裹。\"\n/>\n\n### 练习 2：排序与分页\n\n查询 `users` 表，按 `age` 从大到小排序，并只取前 2 名。\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT * FROM users ...\"\n  answerSql=\"SELECT * FROM users ORDER BY age DESC LIMIT 2\"\n  title=\"练习 2：排序与限制\"\n  description=\"提示：使用 ORDER BY ... DESC 和 LIMIT。\"\n/>\n\n### 练习 3：简单的聚合\n\n查询 `orders` 表，计算所有订单的总金额（`amount` 之和）。\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT ... FROM orders\"\n  answerSql=\"SELECT SUM(amount) AS total_amount FROM orders\"\n  title=\"练习 3：聚合函数\"\n  description=\"提示：使用 SUM() 函数。\"\n/>\n\n---\n\n## 第二部分：分组与多表连接 (Medium)\n\n### 练习 4：分组统计\n\n查询 `orders` 表，统计每种 `status`（状态）下的订单数量。\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT status, ... FROM orders GROUP BY ...\"\n  answerSql=\"SELECT status, COUNT(*) as cnt FROM orders GROUP BY status\"\n  title=\"练习 4：GROUP BY 分组\"\n/>\n\n### 练习 5：INNER JOIN\n\n查询所有 **已下过订单** 的用户，返回 `用户姓名(name)` 和 `订单金额(amount)`。\n(注意：`user_id=99` 的订单不应该出现，因为它没有对应的用户)\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT u.name, o.amount FROM users u JOIN ...\"\n  answerSql=\"SELECT u.name, o.amount FROM users u JOIN orders o ON u.id = o.user_id\"\n  title=\"练习 5：内连接\"\n  description=\"INNER JOIN 只返回两张表都有匹配的数据。\"\n/>\n\n### 练习 6：LEFT JOIN\n\n查询 **所有用户** 的姓名，以及他们的订单金额（如果有的话）。如果用户没有订单，订单金额显示为 `NULL`。\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT u.name, o.amount FROM users u ...\"\n  answerSql=\"SELECT u.name, o.amount FROM users u LEFT JOIN orders o ON u.id = o.user_id\"\n  title=\"练习 6：左连接\"\n  description=\"LEFT JOIN 会保留左表（users）的所有行，即使右表（orders）没有匹配。\"\n/>\n\n---\n\n## 第三部分：进阶挑战 (Hard)\n\n### 练习 7：分组后的过滤 (HAVING)\n\n查询 `users` 表，找出那些 **同名城市** 用户数量大于等于 2 的城市名称。（即：哪个城市住了 2 个或以上的人？）\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT city, COUNT(*) FROM users GROUP BY city ...\"\n  answerSql=\"SELECT city, COUNT(*) as cnt FROM users GROUP BY city HAVING cnt >= 2\"\n  title=\"练习 7：HAVING 子句\"\n  description=\"WHERE 过滤行，HAVING 过滤分组后的结果。\"\n/>\n\n### 练习 8：子查询\n\n查询所有 **下过金额大于 200 的订单** 的用户姓名。\n(可以使用 `JOIN` 也可以使用 `IN` 子查询，这里尝试用子查询)\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT name FROM users WHERE id IN (...)\"\n  answerSql=\"SELECT name FROM users WHERE id IN (SELECT user_id FROM orders WHERE amount > 200)\"\n  title=\"练习 8：IN 子查询\"\n/>\n\n### 练习 9：每个用户的总消费\n\n查询每个用户的 `name` 和 `total_spent`（总消费金额）。如果用户没消费，显示 0 或 NULL 均可（高阶要求：显示 0）。\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT u.name, SUM(o.amount) FROM ...\"\n  answerSql=\"SELECT u.name, COALESCE(SUM(o.amount), 0) as total_spent FROM users u LEFT JOIN orders o ON u.id = o.user_id GROUP BY u.name\"\n  title=\"练习 9：综合统计\"\n  description=\"提示：结合 LEFT JOIN 和 GROUP BY。处理 NULL 可以用 COALESCE() 或 IFNULL()。\"\n/>\n\n### 练习 10：找出没有下过单的用户\n\n<SqlSimulator\n  initialSql={initSql}\n  defaultQuery=\"SELECT name FROM users WHERE ...\"\n  answerSql=\"SELECT name FROM users u WHERE NOT EXISTS (SELECT 1 FROM orders o WHERE o.user_id = u.id)\"\n  title=\"练习 10：NOT EXISTS 或 LEFT JOIN ... IS NULL\"\n  description=\"这是经典的 'Find Missing' 问题。\"\n/>\n\n---\n\n## 总结\n\n通过这 10 道题，你已经覆盖了 SQL 中 90% 的日常使用场景：\n\n1. **基础**：`SELECT`, `WHERE`, `ORDER BY`, `LIMIT`\n2. **聚合**：`COUNT`, `SUM`, `GROUP BY`, `HAVING`\n3. **连接**：`INNER JOIN`, `LEFT JOIN`\n4. **子查询**：`IN`, `EXISTS`\n\n如果你能独立做完这些题，说明你已经具备了扎实的 SQL 基础。建议在真实数据库（MySQL/PostgreSQL）中继续深入学习索引优化与事务处理。\n","isMdxCompiled":true,"category":"sql","title":"SQL 实战练习：在线运行 + 实时验证","date":"2026-01-23","excerpt":"","tags":["SQL","Database","Interactive","Exercises"],"readingTime":"6 分钟阅读"}}
