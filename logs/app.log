{"timestamp":"2026-01-16T07:42:21.162Z","level":"DEBUG","message":"Post data:","data":{"slug":"glsl-battle","content":"\"use strict\";\nconst {Fragment: _Fragment, jsx: _jsx, jsxs: _jsxs} = arguments[0];\nfunction _createMdxContent(props) {\n  const _components = {\n    h1: \"h1\",\n    h2: \"h2\",\n    li: \"li\",\n    ol: \"ol\",\n    p: \"p\",\n    strong: \"strong\",\n    ...props.components\n  }, {ShaderPreview} = _components;\n  if (!ShaderPreview) _missingMdxReference(\"ShaderPreview\", true);\n  return _jsxs(_Fragment, {\n    children: [_jsx(_components.h1, {\n      children: \"GLSL 实战演练：从入门到入土\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"欢迎来到 GLSL 训练场。\\n这里没有枯燥的理论，只有代码和像素。我们将通过四个循序渐进的案例，带你领略 Shader 编程的无限可能。\"\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"Level 1: 简单 —— 雷达扫描 (Radar Scan)\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [_jsx(_components.strong, {\n        children: \"目标\"\n      }), \"：制作一个科幻风格的雷达扫描效果。\\n\", _jsx(_components.strong, {\n        children: \"核心知识点\"\n      }), \"：极坐标、距离场、时间动画。\"]\n    }), \"\\n\", _jsx(ShaderPreview, {\n      title: \"Level 1: Radar\",\n      code: `\nvarying vec2 vUv;\nuniform float uTime;\n\n#define PI 3.14159265359\n\nvoid main() {\n  // 1. 转换坐标系：中心为 (0,0)\n  vec2 st = vUv - 0.5;\n  \n  // 2. 转换为极坐标\n  // 距离 r\n  float r = length(st) * 2.0;\n  // 角度 a (-PI 到 PI)\n  float a = atan(st.y, st.x);\n  \n  // 3. 扫描线逻辑\n  // 让扫描线随时间旋转\n  // 归一化角度到 0-1 范围\n  float angle = fract(a / (2.0 * PI) - uTime * 0.5);\n  \n  // 扫描拖尾效果：越接近 1.0 (扫描线位置) 越亮\n  float beam = smoothstep(0.8, 1.0, angle);\n  \n  // 4. 雷达圈\n  // 使用 fract 和 step 制作同心圆\n  float circles = 1.0 - step(0.02, fract(r * 5.0));\n  \n  // 5. 限制雷达范围\n  float mask = 1.0 - step(1.0, r);\n  \n  // 合成颜色\n  vec3 color = vec3(0.0, 1.0, 0.5) * (beam + circles * 0.3) * mask;\n  \n  gl_FragColor = vec4(color, 1.0);\n}\n`\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"Level 2: 中等 —— 能量护盾 (Energy Shield)\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [_jsx(_components.strong, {\n        children: \"目标\"\n      }), \"：制作一个流动的、带边缘发光的能量护盾。\\n\", _jsx(_components.strong, {\n        children: \"核心知识点\"\n      }), \"：噪声纹理、UV 扭曲、边缘光 (Rim Light)。\"]\n    }), \"\\n\", _jsx(ShaderPreview, {\n      title: \"Level 2: Force Field\",\n      code: `\nvarying vec2 vUv;\nuniform float uTime;\n\n// 简单的 2D 噪声\nfloat noise(vec2 st) {\n  return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n}\n\n// 值噪声 (平滑版)\nfloat valueNoise(vec2 st) {\n  vec2 i = floor(st);\n  vec2 f = fract(st);\n  float a = noise(i);\n  float b = noise(i + vec2(1.0, 0.0));\n  float c = noise(i + vec2(0.0, 1.0));\n  float d = noise(i + vec2(1.0, 1.0));\n  vec2 u = f * f * (3.0 - 2.0 * f);\n  return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n}\n\nvoid main() {\n  // 1. 模拟球体法线 (用于边缘光)\n  vec2 p = vUv * 2.0 - 1.0;\n  float r = length(p);\n  if (r > 1.0) discard;\n  float z = sqrt(1.0 - r*r);\n  vec3 normal = vec3(p.x, p.y, z);\n  \n  // 2. 边缘光 (Fresnel)\n  // 视线方向是 (0,0,1)，点积越小说明越靠近边缘\n  float fresnel = 1.0 - dot(normal, vec3(0.0, 0.0, 1.0));\n  fresnel = pow(fresnel, 3.0); // 增强边缘对比度\n  \n  // 3. 流动纹理\n  // 使用两层噪声叠加，方向相反\n  float n1 = valueNoise(vUv * 10.0 + vec2(0.0, uTime));\n  float n2 = valueNoise(vUv * 15.0 - vec2(uTime * 0.5, 0.0));\n  float energy = n1 * n2;\n  \n  // 4. 合成\n  // 核心颜色 + 边缘高光\n  vec3 coreColor = vec3(0.2, 0.5, 1.0);\n  vec3 glow = coreColor * (energy * 2.0 + fresnel * 3.0);\n  \n  // 增加一点透明度变化\n  float alpha = energy * 0.5 + fresnel;\n  \n  gl_FragColor = vec4(glow, alpha);\n}\n`\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"Level 3: 困难 —— 分形地貌 (Fractal Terrain)\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [_jsx(_components.strong, {\n        children: \"目标\"\n      }), \"：用纯数学公式生成一个俯视的群山地貌。\\n\", _jsx(_components.strong, {\n        children: \"核心知识点\"\n      }), \"：FBM (分形布朗运动)、光照计算、颜色映射。\"]\n    }), \"\\n\", _jsx(ShaderPreview, {\n      title: \"Level 3: Fractal Land\",\n      code: `\nvarying vec2 vUv;\nuniform float uTime;\n\nfloat random(vec2 st) {\n  return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n}\n\nfloat noise(vec2 st) {\n  vec2 i = floor(st);\n  vec2 f = fract(st);\n  float a = random(i);\n  float b = random(i + vec2(1.0, 0.0));\n  float c = random(i + vec2(0.0, 1.0));\n  float d = random(i + vec2(1.0, 1.0));\n  vec2 u = f * f * (3.0 - 2.0 * f);\n  return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n}\n\n// FBM: 叠加多层噪声，模拟地形细节\nfloat fbm(vec2 st) {\n  float v = 0.0;\n  float a = 0.5;\n  mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));\n  for (int i = 0; i < 5; i++) {\n      v += a * noise(st);\n      st = rot * st * 2.0 + vec2(100.0); // 旋转以减少网格感\n      a *= 0.5;\n  }\n  return v;\n}\n\nvoid main() {\n  vec2 st = vUv * 3.0 + vec2(uTime * 0.1, 0.0); // 缓慢飞行\n  \n  // 1. 生成高度图\n  float h = fbm(st);\n  \n  // 2. 颜色映射 (Color Grading)\n  vec3 col = vec3(0.0);\n  \n  // 水面 (深蓝)\n  vec3 water = vec3(0.0, 0.3, 0.6);\n  // 沙滩 (黄色)\n  vec3 sand = vec3(0.8, 0.7, 0.4);\n  // 森林 (绿色)\n  vec3 forest = vec3(0.1, 0.4, 0.1);\n  // 雪山 (白色)\n  vec3 snow = vec3(0.9, 0.9, 1.0);\n  \n  // 根据高度混合颜色\n  if (h < 0.45) col = water;\n  else if (h < 0.5) col = mix(water, sand, (h - 0.45) / 0.05);\n  else if (h < 0.7) col = mix(sand, forest, (h - 0.5) / 0.2);\n  else col = mix(forest, snow, (h - 0.7) / 0.3);\n  \n  // 3. 简单的假光照\n  // 计算导数来模拟法线\n  float d = 0.01;\n  float h_dx = fbm(st + vec2(d, 0.0)) - h;\n  float h_dy = fbm(st + vec2(0.0, d)) - h;\n  vec3 normal = normalize(vec3(-h_dx, -h_dy, d));\n  \n  vec3 lightDir = normalize(vec3(1.0, 1.0, 0.5));\n  float diff = max(dot(normal, lightDir), 0.0);\n  \n  // 阴影加深\n  col *= (0.5 + 0.5 * diff);\n  \n  gl_FragColor = vec4(col, 1.0);\n}\n`\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"Level 4: 入神 —— 光线追踪 (Ray Tracing)\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [_jsx(_components.strong, {\n        children: \"目标\"\n      }), \"：在一个 Shader 里实现真正的光线反射。\\n\", _jsx(_components.strong, {\n        children: \"核心知识点\"\n      }), \"：Ray Tracing 核心循环、反射、材质。\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"这是一个极简的光线追踪器。它不是 Ray Marching，而是解析几何求交。\"\n    }), \"\\n\", _jsx(ShaderPreview, {\n      title: \"Level 4: Ray Tracer\",\n      code: `\nvarying vec2 vUv;\nuniform float uTime;\n\n// 射线结构体\nstruct Ray { vec3 ro; vec3 rd; };\n\n// 球体求交函数\n// 返回距离，如果没有击中返回 -1.0\nfloat iSphere(Ray ray, vec3 pos, float r) {\n  vec3 oc = ray.ro - pos;\n  float b = dot(oc, ray.rd);\n  float c = dot(oc, oc) - r*r;\n  float h = b*b - c;\n  if (h < 0.0) return -1.0;\n  return -b - sqrt(h);\n}\n\nvoid main() {\n  // 1. 相机设置\n  vec2 uv = vUv * 2.0 - 1.0;\n  vec3 ro = vec3(0.0, 0.0, 3.0); // 相机位置\n  vec3 rd = normalize(vec3(uv, -1.5)); // 射线方向\n  \n  vec3 col = vec3(0.0); // 最终颜色\n  vec3 ref = vec3(1.0); // 反射衰减系数\n  \n  // 场景定义：一个大球和一个移动的小球\n  vec3 sphere1 = vec3(0.0, -100.5, -1.0); // 地面(超大球)\n  float r1 = 100.0;\n  vec3 sphere2 = vec3(sin(uTime), 0.0, -1.0); // 浮动球\n  float r2 = 0.8;\n  \n  // 光源\n  vec3 light = normalize(vec3(0.5, 0.8, 0.5));\n  \n  // 2. 光线弹射循环 (最多弹射 3 次)\n  for(int i = 0; i < 3; i++) {\n      // 求交\n      float t1 = iSphere(Ray(ro, rd), sphere1, r1);\n      float t2 = iSphere(Ray(ro, rd), sphere2, r2);\n      \n      float t = 10000.0;\n      vec3 pos = vec3(0.0);\n      vec3 n = vec3(0.0);\n      vec3 matCol = vec3(0.0);\n      float id = -1.0;\n      \n      // 找到最近的交点\n      if(t1 > 0.0 && t1 < t) { t = t1; id = 1.0; }\n      if(t2 > 0.0 && t2 < t) { t = t2; id = 2.0; }\n      \n      // 如果没击中任何物体，渲染天空并退出\n      if(id < 0.0) {\n          vec3 sky = mix(vec3(0.5, 0.7, 1.0), vec3(0.1, 0.3, 0.6), rd.y*0.5+0.5);\n          col += ref * sky;\n          break;\n      }\n      \n      // 计算击中点信息\n      pos = ro + rd * t;\n      \n      if(id == 1.0) { // 地面\n          n = normalize(pos - sphere1);\n          // 棋盘格材质\n          float check = mod(floor(pos.x*2.0) + floor(pos.z*2.0), 2.0);\n          matCol = vec3(0.3 + check * 0.3);\n      } else { // 球体\n          n = normalize(pos - sphere2);\n          matCol = vec3(1.0, 0.2, 0.2); // 红色镜面球\n      }\n      \n      // 简单的漫反射光照\n      float diff = max(dot(n, light), 0.0);\n      vec3 color = matCol * diff;\n      \n      // 累加颜色\n      col += ref * color * 0.5; // 0.5 是因为物体也会吸收光\n      \n      // 准备下一次弹射\n      ref *= 0.5; // 每次反射能量减半 (如果是完美镜面则不减)\n      if(id == 2.0) ref *= vec3(1.0, 0.5, 0.5); // 红色球反射红光\n      \n      ro = pos + n * 0.001; // 防止自我遮挡\n      rd = reflect(rd, n); // 反射方向\n  }\n  \n  // Gamma 校正\n  col = pow(col, vec3(0.4545));\n  \n  gl_FragColor = vec4(col, 1.0);\n}\n`\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"结语\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"从画圆圈到模拟光线反弹，GLSL 的上限取决于你的数学想象力。\\n这四个例子涵盖了 Shader 编程的四大流派：\", _jsx(_components.strong, {\n        children: \"2D 图形\"\n      }), \"、\", _jsx(_components.strong, {\n        children: \"特效/VFX\"\n      }), \"、\", _jsx(_components.strong, {\n        children: \"程序化生成\"\n      }), \"、\", _jsx(_components.strong, {\n        children: \"物理渲染\"\n      }), \"。\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"你可以试着修改代码：\"\n    }), \"\\n\", _jsxs(_components.ol, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"给雷达加上颜色渐变。\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"改变护盾的流动速度。\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"给地貌加上云层。\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"在光线追踪里加第三个球。\"\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"祝你在代码的宇宙里玩得开心！\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = props.components || ({});\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\nfunction _missingMdxReference(id, component) {\n  throw new Error(\"Expected \" + (component ? \"component\" : \"object\") + \" `\" + id + \"` to be defined: you likely forgot to import, pass, or provide it.\");\n}\n","rawContent":"\n# GLSL 实战演练：从入门到入土\n\n欢迎来到 GLSL 训练场。\n这里没有枯燥的理论，只有代码和像素。我们将通过四个循序渐进的案例，带你领略 Shader 编程的无限可能。\n\n## Level 1: 简单 —— 雷达扫描 (Radar Scan)\n\n**目标**：制作一个科幻风格的雷达扫描效果。\n**核心知识点**：极坐标、距离场、时间动画。\n\n<ShaderPreview title=\"Level 1: Radar\" code={`\nvarying vec2 vUv;\nuniform float uTime;\n\n#define PI 3.14159265359\n\nvoid main() {\n    // 1. 转换坐标系：中心为 (0,0)\n    vec2 st = vUv - 0.5;\n    \n    // 2. 转换为极坐标\n    // 距离 r\n    float r = length(st) * 2.0;\n    // 角度 a (-PI 到 PI)\n    float a = atan(st.y, st.x);\n    \n    // 3. 扫描线逻辑\n    // 让扫描线随时间旋转\n    // 归一化角度到 0-1 范围\n    float angle = fract(a / (2.0 * PI) - uTime * 0.5);\n    \n    // 扫描拖尾效果：越接近 1.0 (扫描线位置) 越亮\n    float beam = smoothstep(0.8, 1.0, angle);\n    \n    // 4. 雷达圈\n    // 使用 fract 和 step 制作同心圆\n    float circles = 1.0 - step(0.02, fract(r * 5.0));\n    \n    // 5. 限制雷达范围\n    float mask = 1.0 - step(1.0, r);\n    \n    // 合成颜色\n    vec3 color = vec3(0.0, 1.0, 0.5) * (beam + circles * 0.3) * mask;\n    \n    gl_FragColor = vec4(color, 1.0);\n}\n`} />\n\n## Level 2: 中等 —— 能量护盾 (Energy Shield)\n\n**目标**：制作一个流动的、带边缘发光的能量护盾。\n**核心知识点**：噪声纹理、UV 扭曲、边缘光 (Rim Light)。\n\n<ShaderPreview title=\"Level 2: Force Field\" code={`\nvarying vec2 vUv;\nuniform float uTime;\n\n// 简单的 2D 噪声\nfloat noise(vec2 st) {\n    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n}\n\n// 值噪声 (平滑版)\nfloat valueNoise(vec2 st) {\n    vec2 i = floor(st);\n    vec2 f = fract(st);\n    float a = noise(i);\n    float b = noise(i + vec2(1.0, 0.0));\n    float c = noise(i + vec2(0.0, 1.0));\n    float d = noise(i + vec2(1.0, 1.0));\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n}\n\nvoid main() {\n    // 1. 模拟球体法线 (用于边缘光)\n    vec2 p = vUv * 2.0 - 1.0;\n    float r = length(p);\n    if (r > 1.0) discard;\n    float z = sqrt(1.0 - r*r);\n    vec3 normal = vec3(p.x, p.y, z);\n    \n    // 2. 边缘光 (Fresnel)\n    // 视线方向是 (0,0,1)，点积越小说明越靠近边缘\n    float fresnel = 1.0 - dot(normal, vec3(0.0, 0.0, 1.0));\n    fresnel = pow(fresnel, 3.0); // 增强边缘对比度\n    \n    // 3. 流动纹理\n    // 使用两层噪声叠加，方向相反\n    float n1 = valueNoise(vUv * 10.0 + vec2(0.0, uTime));\n    float n2 = valueNoise(vUv * 15.0 - vec2(uTime * 0.5, 0.0));\n    float energy = n1 * n2;\n    \n    // 4. 合成\n    // 核心颜色 + 边缘高光\n    vec3 coreColor = vec3(0.2, 0.5, 1.0);\n    vec3 glow = coreColor * (energy * 2.0 + fresnel * 3.0);\n    \n    // 增加一点透明度变化\n    float alpha = energy * 0.5 + fresnel;\n    \n    gl_FragColor = vec4(glow, alpha);\n}\n`} />\n\n## Level 3: 困难 —— 分形地貌 (Fractal Terrain)\n\n**目标**：用纯数学公式生成一个俯视的群山地貌。\n**核心知识点**：FBM (分形布朗运动)、光照计算、颜色映射。\n\n<ShaderPreview title=\"Level 3: Fractal Land\" code={`\nvarying vec2 vUv;\nuniform float uTime;\n\nfloat random(vec2 st) {\n    return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);\n}\n\nfloat noise(vec2 st) {\n    vec2 i = floor(st);\n    vec2 f = fract(st);\n    float a = random(i);\n    float b = random(i + vec2(1.0, 0.0));\n    float c = random(i + vec2(0.0, 1.0));\n    float d = random(i + vec2(1.0, 1.0));\n    vec2 u = f * f * (3.0 - 2.0 * f);\n    return mix(a, b, u.x) + (c - a)* u.y * (1.0 - u.x) + (d - b) * u.x * u.y;\n}\n\n// FBM: 叠加多层噪声，模拟地形细节\nfloat fbm(vec2 st) {\n    float v = 0.0;\n    float a = 0.5;\n    mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));\n    for (int i = 0; i < 5; i++) {\n        v += a * noise(st);\n        st = rot * st * 2.0 + vec2(100.0); // 旋转以减少网格感\n        a *= 0.5;\n    }\n    return v;\n}\n\nvoid main() {\n    vec2 st = vUv * 3.0 + vec2(uTime * 0.1, 0.0); // 缓慢飞行\n    \n    // 1. 生成高度图\n    float h = fbm(st);\n    \n    // 2. 颜色映射 (Color Grading)\n    vec3 col = vec3(0.0);\n    \n    // 水面 (深蓝)\n    vec3 water = vec3(0.0, 0.3, 0.6);\n    // 沙滩 (黄色)\n    vec3 sand = vec3(0.8, 0.7, 0.4);\n    // 森林 (绿色)\n    vec3 forest = vec3(0.1, 0.4, 0.1);\n    // 雪山 (白色)\n    vec3 snow = vec3(0.9, 0.9, 1.0);\n    \n    // 根据高度混合颜色\n    if (h < 0.45) col = water;\n    else if (h < 0.5) col = mix(water, sand, (h - 0.45) / 0.05);\n    else if (h < 0.7) col = mix(sand, forest, (h - 0.5) / 0.2);\n    else col = mix(forest, snow, (h - 0.7) / 0.3);\n    \n    // 3. 简单的假光照\n    // 计算导数来模拟法线\n    float d = 0.01;\n    float h_dx = fbm(st + vec2(d, 0.0)) - h;\n    float h_dy = fbm(st + vec2(0.0, d)) - h;\n    vec3 normal = normalize(vec3(-h_dx, -h_dy, d));\n    \n    vec3 lightDir = normalize(vec3(1.0, 1.0, 0.5));\n    float diff = max(dot(normal, lightDir), 0.0);\n    \n    // 阴影加深\n    col *= (0.5 + 0.5 * diff);\n    \n    gl_FragColor = vec4(col, 1.0);\n}\n`} />\n\n## Level 4: 入神 —— 光线追踪 (Ray Tracing)\n\n**目标**：在一个 Shader 里实现真正的光线反射。\n**核心知识点**：Ray Tracing 核心循环、反射、材质。\n\n这是一个极简的光线追踪器。它不是 Ray Marching，而是解析几何求交。\n\n<ShaderPreview title=\"Level 4: Ray Tracer\" code={`\nvarying vec2 vUv;\nuniform float uTime;\n\n// 射线结构体\nstruct Ray { vec3 ro; vec3 rd; };\n\n// 球体求交函数\n// 返回距离，如果没有击中返回 -1.0\nfloat iSphere(Ray ray, vec3 pos, float r) {\n    vec3 oc = ray.ro - pos;\n    float b = dot(oc, ray.rd);\n    float c = dot(oc, oc) - r*r;\n    float h = b*b - c;\n    if (h < 0.0) return -1.0;\n    return -b - sqrt(h);\n}\n\nvoid main() {\n    // 1. 相机设置\n    vec2 uv = vUv * 2.0 - 1.0;\n    vec3 ro = vec3(0.0, 0.0, 3.0); // 相机位置\n    vec3 rd = normalize(vec3(uv, -1.5)); // 射线方向\n    \n    vec3 col = vec3(0.0); // 最终颜色\n    vec3 ref = vec3(1.0); // 反射衰减系数\n    \n    // 场景定义：一个大球和一个移动的小球\n    vec3 sphere1 = vec3(0.0, -100.5, -1.0); // 地面(超大球)\n    float r1 = 100.0;\n    vec3 sphere2 = vec3(sin(uTime), 0.0, -1.0); // 浮动球\n    float r2 = 0.8;\n    \n    // 光源\n    vec3 light = normalize(vec3(0.5, 0.8, 0.5));\n    \n    // 2. 光线弹射循环 (最多弹射 3 次)\n    for(int i = 0; i < 3; i++) {\n        // 求交\n        float t1 = iSphere(Ray(ro, rd), sphere1, r1);\n        float t2 = iSphere(Ray(ro, rd), sphere2, r2);\n        \n        float t = 10000.0;\n        vec3 pos = vec3(0.0);\n        vec3 n = vec3(0.0);\n        vec3 matCol = vec3(0.0);\n        float id = -1.0;\n        \n        // 找到最近的交点\n        if(t1 > 0.0 && t1 < t) { t = t1; id = 1.0; }\n        if(t2 > 0.0 && t2 < t) { t = t2; id = 2.0; }\n        \n        // 如果没击中任何物体，渲染天空并退出\n        if(id < 0.0) {\n            vec3 sky = mix(vec3(0.5, 0.7, 1.0), vec3(0.1, 0.3, 0.6), rd.y*0.5+0.5);\n            col += ref * sky;\n            break;\n        }\n        \n        // 计算击中点信息\n        pos = ro + rd * t;\n        \n        if(id == 1.0) { // 地面\n            n = normalize(pos - sphere1);\n            // 棋盘格材质\n            float check = mod(floor(pos.x*2.0) + floor(pos.z*2.0), 2.0);\n            matCol = vec3(0.3 + check * 0.3);\n        } else { // 球体\n            n = normalize(pos - sphere2);\n            matCol = vec3(1.0, 0.2, 0.2); // 红色镜面球\n        }\n        \n        // 简单的漫反射光照\n        float diff = max(dot(n, light), 0.0);\n        vec3 color = matCol * diff;\n        \n        // 累加颜色\n        col += ref * color * 0.5; // 0.5 是因为物体也会吸收光\n        \n        // 准备下一次弹射\n        ref *= 0.5; // 每次反射能量减半 (如果是完美镜面则不减)\n        if(id == 2.0) ref *= vec3(1.0, 0.5, 0.5); // 红色球反射红光\n        \n        ro = pos + n * 0.001; // 防止自我遮挡\n        rd = reflect(rd, n); // 反射方向\n    }\n    \n    // Gamma 校正\n    col = pow(col, vec3(0.4545));\n    \n    gl_FragColor = vec4(col, 1.0);\n}\n`} />\n\n## 结语\n\n从画圆圈到模拟光线反弹，GLSL 的上限取决于你的数学想象力。\n这四个例子涵盖了 Shader 编程的四大流派：**2D 图形**、**特效/VFX**、**程序化生成**、**物理渲染**。\n\n你可以试着修改代码：\n1.  给雷达加上颜色渐变。\n2.  改变护盾的流动速度。\n3.  给地貌加上云层。\n4.  在光线追踪里加第三个球。\n\n祝你在代码的宇宙里玩得开心！\n","isMdxCompiled":true,"category":"practice","title":"GLSL 实战演练：从入门到入土","date":"2026-01-16","excerpt":"","tags":["WebGL","GLSL","Practice","Tutorial"],"readingTime":"3 分钟阅读"}}
