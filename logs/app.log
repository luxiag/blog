     }), \" fruit.\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"toUpperCase\"\n        }), \"());\\r\\n\", _jsx(_components.span, {\n          className: \"hljs-variable language_\",\n          children: \"console\"\n        }), \".\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"log\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"\\\"大写水果名:\\\"\"\n        }), \", upperFruits);\\r\\n\\r\\n\", _jsx(_components.span, {\n          className: \"hljs-comment\",\n          children: \"// 检查是否包含特定水果\"\n        }), \"\\r\\n\", _jsx(_components.span, {\n          className: \"hljs-variable language_\",\n          children: \"console\"\n        }), \".\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"log\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"\\\"是否包含'apple':\\\"\"\n        }), \", fruits.\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"includes\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"'apple'\"\n        }), \"));\\r\\n\", _jsx(_components.span, {\n          className: \"hljs-variable language_\",\n          children: \"console\"\n        }), \".\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"log\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"\\\"是否包含'pear':\\\"\"\n        }), \", fruits.\", _jsx(_components.span, {\n          className: \"hljs-title function_\",\n          children: \"includes\"\n        }), \"(\", _jsx(_components.span, {\n          className: \"hljs-string\",\n          children: \"'pear'\"\n        }), \"));\\n\"]\n      })\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"注意事项\"\n    }), \"\\n\", _jsxs(_components.ol, {\n      children: [\"\\n\", _jsx(_components.li, {\n        children: \"目前只支持 JavaScript 代码的运行\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"出于安全考虑，代码运行在受限环境中\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"代码只能访问 console 对象，无法访问 DOM、网络等 API\"\n      }), \"\\n\", _jsx(_components.li, {\n        children: \"复杂的计算可能需要一些时间才能完成\"\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"总结\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"通过这个功能，你可以创建交互式的教程和演示，让读者直接在博客中运行代码并查看结果，大大提升了学习和体验的效果。\"\n    })]\n  });\n}\nfunction MDXContent(props = {}) {\n  const {wrapper: MDXLayout} = props.components || ({});\n  return MDXLayout ? _jsx(MDXLayout, {\n    ...props,\n    children: _jsx(_createMdxContent, {\n      ...props\n    })\n  }) : _createMdxContent(props);\n}\nreturn {\n  default: MDXContent\n};\n","rawContent":"\r\n---\r\ntitle: 代码运行功能演示\r\ndate: 2023-12-15\r\nexcerpt: 演示如何在博客中使用可运行的 JavaScript 代码块\r\ntags: [JavaScript, 交互式, 演示]\r\n---\r\n\r\n# 代码运行功能演示\r\n\r\n本篇博客演示了如何在 Markdown 文件中添加可运行的 JavaScript 代码。\r\n\r\n## 基本用法\r\n\r\n有两种方式可以标记代码块为可运行：\r\n\r\n### 方法1：添加特殊注释\r\n\r\n在代码块的第一行添加 `// 可运行` 或 `// runnable` 注释：\r\n\r\n```javascript\r\n// 可运行\r\nconst message = \"Hello, World!\";\r\nconsole.log(message);\r\n```\r\n\r\n### 方法2：使用 data-runnable 属性（高级用法）\r\n\r\n```javascript {data-runnable=\"true\"}\r\nconst numbers = [1, 2, 3, 4, 5];\r\nconst doubled = numbers.map(n => n * 2);\r\nconsole.log(\"原始数组:\", numbers);\r\nconsole.log(\"翻倍后的数组:\", doubled);\r\n```\r\n\r\n## 示例：计算器\r\n\r\n下面是一个简单的计算器示例：\r\n\r\n```javascript\r\n// 可运行\r\nfunction calculate(operation, a, b) {\r\n  switch(operation) {\r\n    case 'add':\r\n      return a + b;\r\n    case 'subtract':\r\n      return a - b;\r\n    case 'multiply':\r\n      return a * b;\r\n    case 'divide':\r\n      return b !== 0 ? a / b : 'Error: Division by zero';\r\n    default:\r\n      return 'Error: Unknown operation';\r\n  }\r\n}\r\n\r\nconsole.log(\"10 + 5 =\", calculate('add', 10, 5));\r\nconsole.log(\"10 - 5 =\", calculate('subtract', 10, 5));\r\nconsole.log(\"10 * 5 =\", calculate('multiply', 10, 5));\r\nconsole.log(\"10 / 5 =\", calculate('divide', 10, 5));\r\n```\r\n\r\n## 示例：数组操作\r\n\r\n```javascript\r\n// 可运行\r\nconst fruits = ['apple', 'banana', 'orange', 'grape', 'kiwi'];\r\n\r\n// 过滤长度大于5的水果\r\nconst longFruits = fruits.filter(fruit => fruit.length > 5);\r\nconsole.log(\"长度大于5的水果:\", longFruits);\r\n\r\n// 将所有水果名转为大写\r\nconst upperFruits = fruits.map(fruit => fruit.toUpperCase());\r\nconsole.log(\"大写水果名:\", upperFruits);\r\n\r\n// 检查是否包含特定水果\r\nconsole.log(\"是否包含'apple':\", fruits.includes('apple'));\r\nconsole.log(\"是否包含'pear':\", fruits.includes('pear'));\r\n```\r\n\r\n## 注意事项\r\n\r\n1. 目前只支持 JavaScript 代码的运行\r\n2. 出于安全考虑，代码运行在受限环境中\r\n3. 代码只能访问 console 对象，无法访问 DOM、网络等 API\r\n4. 复杂的计算可能需要一些时间才能完成\r\n\r\n## 总结\r\n\r\n通过这个功能，你可以创建交互式的教程和演示，让读者直接在博客中运行代码并查看结果，大大提升了学习和体验的效果。\r\n","title":"无标题","date":"2026-01-14","excerpt":"","tags":[],"readingTime":"2 分钟阅读"}}
