       children: \"Radius (半径)\"\n        }), \"：离目标的距离。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Phi (极角)\"\n        }), \"：与 Y 轴的夹角 (俯仰)。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Theta (方位角)\"\n        }), \"：在 XZ 平面上的角度 (旋转)。\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"每次渲染时，我们把球坐标转回直角坐标：\"\n    }), \"\\n\", _jsx(_components.pre, {\n      children: _jsx(_components.code, {\n        className: \"hljs language-glsl\",\n        children: \"x = radius * sin(phi) * cos(theta);\\ny = radius * cos(phi);\\nz = radius * sin(phi) * sin(theta);\\n\"\n      })\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"2. FPS 相机 (First Person Controls)\"\n    }), \"\\n\", _jsx(_components.p, {\n      children: \"这是游戏的标准配置：WASD 移动，鼠标控制视角。\\n这里没有\\\"目标点\\\"，只有\\\"前方\\\"。\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [_jsx(_components.strong, {\n        children: \"核心逻辑\"\n      }), \"：\"]\n    }), \"\\n\", _jsxs(_components.ul, {\n      children: [\"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Pitch (俯仰)\"\n        }), \"：绕 X 轴旋转（点头）。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Yaw (偏航)\"\n        }), \"：绕 Y 轴旋转（摇头）。\"]\n      }), \"\\n\", _jsxs(_components.li, {\n        children: [_jsx(_components.strong, {\n          children: \"Roll (翻滚)\"\n        }), \"：绕 Z 轴旋转（歪头，FPS 中很少用）。\"]\n      }), \"\\n\"]\n    }), \"\\n\", _jsx(_components.h2, {\n      children: \"二、 欧拉角 vs 四元数：旋转的噩梦\"\n    }), \"\\n\", _jsxs(_components.p, {\n      children: [\"当你尝试写一个 FPS 相机时，你可能会遇到一个恐怖的问题：\", _jsx(_components.strong, {\n        children: \"万向节死锁 (Gimbal Lock)\"\n      }), \"。\"]\n    }), \"\\n\", _jsx(_components.h3, {\n      children: \"1. 欧拉角 (Euler Angles)\"\n   